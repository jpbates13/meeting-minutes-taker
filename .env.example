# Copy to .env next to docker-compose.yml. All optional.

# Host the browser uses (frontend at /, API at /api), e.g. minutes.example.com
PUBLIC_HOST=
# Restrict CORS to the site, e.g. https://minutes.example.com ("*" allows any origin)
ALLOWED_ORIGINS=

# Hugging Face token for pyannote speaker diarization. Accept the terms of
# pyannote/speaker-diarization-community-1 first. Unset → no speaker labels.
HF_TOKEN=
# Only for the cloud (OpenAI) minutes option.
OPENAI_API_KEY=

# Shared services (defaults shown in docker-compose.yml)
# STT_URL=http://ai-stt-whisper:8000/v1
# STT_MODEL=Systran/faster-whisper-large-v3
# LOCAL_LLM_BASE_URL=http://ai-llm:11434/v1
# LOCAL_LLM_MODEL=gemma4:12b-32k
